# Set a long random value before exposing NOVA publicly.
NOVA_API_KEY=

# Required to enable account registration and JWT authentication (generate 32+ random chars).
NOVA_AUTH_SECRET=
NOVA_AUTH_ACCESS_TTL=900
NOVA_AUTH_REFRESH_TTL=2592000

# Shared provider credentials (optional; configure only providers you use).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Runtime
NOVA_DATABASE_PATH=./data/nova.db
NOVA_MODELS_FILE=./config/models.json
NOVA_REQUEST_TIMEOUT=35
NOVA_MAX_CONTEXT_MESSAGES=24
NOVA_MAX_FAILOVERS=3
